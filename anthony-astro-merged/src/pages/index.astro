---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
---
<Base title="Anthony Grummett — Game Programmer" description="Gameplay programmer portfolio: systems, proc-gen, tools, performance.">
  <section class="hero">
    <h1>Anthony Grummett — <span style="opacity:.8">Gameplay Programmer</span></h1>
    <p>Procedural generation, systems programming, performance, and tools. Unity • C#.</p>
    <div class="cta">
      <a class="button" href="/projects">View Projects</a>
      <a class="button secondary" href="/Anthony_Grummett_CV.pdf">Download CV</a>
    </div>
  </section>

  <section>
    <h2>Featured Projects</h2>
    <div class="grid">
      <!-- Newer projects -->
      <ProjectCard
      href="/projects/reefbound"
      title="Reefbound — Procedural Voxel Ocean Survival"
      blurb="Final-year Unity project with custom voxel terrain, chunk meshing, block-based water, crafting, smelting, mobs, and underwater survival systems."
      tags={['Unity','C#','Voxels','Proc Gen','Survival']}
      image="/media/reefbound-hero.jpg"
      />

      <ProjectCard
      href="/projects/mousechitect"
      title="Mousechitect — City Builder Tools"
      blurb="Unity city-builder work focused on grid build tools, path placement, object movement, destruction flow, morale scoring, and visible mouse population feedback."
      tags={["Unity", "C#", "Tools", "Systems", "Simulation"]}
      image="/media/mousechitect/mousechitect-thumb.jpg"
      />

      <ProjectCard
      href="/projects/project-astrorot"
      title="Project AstroRot — Lunar Zombie AI Shooter"
      blurb="Unity FPS prototype about containing a zombie outbreak on the Moon, with custom grid-based A* pathfinding, perception-driven AI, enemy variants, waves, scoring, and responsive combat."
      tags={['Unity','C#','AI','A* Pathfinding','FPS']}
      image="/media/project-astrorot/project-astrorot-thumb.jpg"
      />

      <ProjectCard
      href="/projects/ki-warden"
      title="Ki Warden — Game Boy Colour Survival Shooter"
      blurb="Game Boy Colour survival shooter built in RGBDS assembly for the Targeting Platforms module, featuring wave-based spirit enemies, Ki projectiles, limited Ki wave charges, scoring, day progression, custom HUD, and hardware-driven sound."
      tags={['Game Boy','RGBDS','Assembly','GBC','Survival Shooter']}
      image="/media/ki-warden/images/ki-warden-thumb.jpg"
      />

            <ProjectCard href="/projects/maths-for-games" 
      title="AsterAvoid - uni project" 
      blurb="A game built for my maths for games module at uni, combining a build system and a flight system to make a spaceship" 
      tags={['Unity','Physics','Raycasting']} 
      image="/media/maths-for-games.jpg" />

      <ProjectCard href="/projects/low-poly-rat-sim" 
      title="Low‑poly Rat Simulator" 
      blurb="URP + Cinemachine; ragdoll physics & tunnel mechanics." 
      tags={['Unity','URP','C#']} 
      image="/media/rat-sim.jpg" />


  </section>
</Base>
